# SKAI — пример переменных окружения.
# Скопируй в `.env` и заполни значения: `cp .env.example .env`
# (.env в .gitignore — секреты в репозиторий не коммитим).

# ── AI Providers (для OpenCode / генерации кода) ─────────────────────────────
# DeepSeek API: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Alibaba DashScope (Qwen3): https://dashscope.aliyun.com → API Keys
DASHSCOPE_API_KEY=

# ── Backend: Voice/NLU (00-CONTRACT.md §7.3) ──────────────────────────────────
# SKAI_GROQ_API_KEY пуст → nlu_service падает на локальный regex-fallback (без сети).
SKAI_GROQ_API_KEY=
SKAI_WHISPER_MODEL=large-v3
SKAI_WHISPER_DEVICE=cpu
# SKAI_WHISPER_COMPUTE_TYPE — CTranslate2 compute-тип. "default" → авто под железо.
#   На Apple Silicon (M1-M4) "default" выбирает float16 (int8 не даёт выигрыша на ARM).
#   Форсировать: "int8", "int8_float16", "float16", "float32".
SKAI_WHISPER_COMPUTE_TYPE=default
# SKAI_WHISPER_CPU_THREADS — 0 → автоопределение CTranslate2.
#   На 12-ядерном M4 Pro рекомендуется 8 (оставить 4 ядра под API/OS).
SKAI_WHISPER_CPU_THREADS=8
# SKAI_WHISPER_NUM_WORKERS — параллельная обработка сегментов (≥2 для многоядерных CPU).
SKAI_WHISPER_NUM_WORKERS=2

# ── Performance: DuckDB PRAGMAs ────────────────────────────────────────────────
# SKAI_DUCKDB_THREADS — 0 → авто DuckDB; 8 на M4 Pro, 4-8 на Windows.
SKAI_DUCKDB_THREADS=8
# SKAI_DUCKDB_MEMORY_LIMIT_MB — 0 → без лимита; 4096 (4 GB) на M4 Pro,
#   чтобы Whisper не вытеснился из памяти.
SKAI_DUCKDB_MEMORY_LIMIT_MB=4096

# ── Performance: Uvicorn workers ───────────────────────────────────────────────
# SKAI_API_WORKERS — 0 → авто (cpu_count); 4 на M4 Pro, 2-4 на Windows.
#   С --reload воркеры не применяются (dev-режим использует `make api`).
#   `make api-prod` читает эту переменную.
SKAI_API_WORKERS=4

# ── Frontend: Vite (web/) ─────────────────────────────────────────────────────
# VITE_API_BASE   — базовый префикс API-клиента (client.ts).
# VITE_API_TARGET — куда Vite-proxy шлёт /api в dev-режиме (vite.config.ts).
# VITE_USE_FIXTURES=true — экраны рендерятся на статичных фикстурах f3, без бэка.
VITE_API_BASE=/api
VITE_API_TARGET=http://localhost:8000
VITE_USE_FIXTURES=false
