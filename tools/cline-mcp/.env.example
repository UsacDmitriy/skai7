# Cline API MCP bridge — ключ и (опционально) переопределение slug'ов моделей.
# Скопируйте в .env и впишите ключ:  cp .env.example .env
# Ключ: https://app.cline.bot → Settings → API Keys
CLINE_API_KEY=...

# Переопределение моделей. Префикс cline-pass/ = подписка ClinePass (flat).
# Голый vendor/model роутит через usage-billing (кредиты) — НЕ используйте.
# CLINE_GLM_MODEL=cline-pass/glm-5.2
# CLINE_KIMI_CODE_MODEL=cline-pass/kimi-k2.7-code
# CLINE_KIMI_MODEL=cline-pass/kimi-k2.6
# CLINE_DEEPSEEK_MODEL=cline-pass/deepseek-v4-pro
# CLINE_DEEPSEEK_FLASH_MODEL=cline-pass/deepseek-v4-flash
# CLINE_MINIMAX_MODEL=cline-pass/minimax-m3
# CLINE_MIMO_MODEL=cline-pass/mimo-v2.5
# CLINE_MIMO_PRO_MODEL=cline-pass/mimo-v2.5-pro
# CLINE_QWEN_MAX_MODEL=cline-pass/qwen3.7-max
# CLINE_QWEN_MODEL=cline-pass/qwen3.7-plus
