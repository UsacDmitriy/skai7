# Committed ClinePass model registry. Never put API keys in this file.
# Every model must keep the cline-pass/ subscription prefix.
# Only the Kimi, DeepSeek, Qwen and GLM families are allowed.
CLINE_MODEL_KIMI_K3=cline-pass/kimi-k3
CLINE_MODEL_KIMI_CODE=cline-pass/kimi-k2.7-code
CLINE_MODEL_KIMI=cline-pass/kimi-k2.6
CLINE_MODEL_DEEPSEEK_PRO=cline-pass/deepseek-v4-pro
CLINE_MODEL_DEEPSEEK_FLASH=cline-pass/deepseek-v4-flash
CLINE_MODEL_GLM=cline-pass/glm-5.2
CLINE_MODEL_GLM_53=cline-pass/glm-5.3
CLINE_MODEL_QWEN_MAX=cline-pass/qwen3.7-max
CLINE_MODEL_QWEN=cline-pass/qwen3.7-plus
CLINE_MODEL_QWEN_38_MAX=cline-pass/qwen3.8-max

# Task routes. Values are aliases from CLINE_MODEL_* above.
CLINE_ROUTE_SIMPLE=deepseek-flash
CLINE_ROUTE_SIMPLE_STRUCTURED=kimi-k3
CLINE_ROUTE_CODE=kimi-code
CLINE_ROUTE_SYNTHESIS=deepseek-pro
CLINE_ROUTE_REVIEW=kimi-k3
