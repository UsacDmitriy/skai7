# OpenRouter MCP bridge — ключ и (опционально) переопределение slug'ов моделей.
# Скопируйте в .env и впишите ключ:  cp .env.example .env
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Переопределение моделей (по умолчанию — реестр METHODOLOGY §3).
# Сверяйте актуальные slug'и: https://openrouter.ai/models
# OPENROUTER_GLM_MODEL=z-ai/glm-5.2
# OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4-pro
# OPENROUTER_DEEPSEEK_FLASH_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_QWEN_MODEL=qwen/qwen3.7-max
# OPENROUTER_KIMI_MODEL=moonshotai/kimi-k2.7-code
